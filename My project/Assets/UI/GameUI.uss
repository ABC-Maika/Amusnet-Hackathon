.game-root {
    flex-grow: 1;
}

/* ---------- HUD: cream petal cards over the world ---------- */

.hud {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-cubic;
}

.hud--dimmed {
    opacity: 0.25;
}

.hud--off {
    opacity: 0;
}

.hud-card {
    position: absolute;
    background-color: rgba(244, 239, 225, 0.94);
    border-bottom-width: 4px;
    border-color: var(--c-cream-lip);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-right-radius: 26px;
    border-bottom-left-radius: 8px;
}

.hud-caption {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 15px;
    letter-spacing: 4px;
    color: var(--c-ink);
}

/* The "Esc to pause" hint only makes sense during play. */
.hud--dimmed > .hud-hint {
    display: none;
}

.hud-hint {
    position: absolute;
    left: 40px;
    bottom: 36px;
    padding: 8px 18px;
    font-size: 16px;
    color: var(--c-cream);
    background-color: rgba(39, 37, 43, 0.62);
    border-radius: 18px;
}

.mess {
    top: 32px;
    left: 50%;
    width: 720px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 14px 26px;
}

.mess-track {
    flex-grow: 1;
    height: 16px;
    margin: 0 18px;
    background-color: var(--c-track);
    border-radius: 8px;
    overflow: hidden;
}

.mess-fill {
    width: 0;
    height: 100%;
    background-color: var(--c-gold);
    border-radius: 8px;
    overflow: hidden;
    transition-property: width, background-color;
    transition-duration: 0.45s, 0.3s;
    transition-timing-function: ease-out-cubic, linear;
}

.mess-fill--bump {
    background-color: #F2CB85;
}

.mess-shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 60px;
    background-color: rgba(255, 253, 247, 0.55);
    rotate: 20deg;
    translate: -80px 0;
    transition-property: translate;
    transition-duration: 2.4s;
    transition-timing-function: ease-in-out-sine;
}

.mess-shine--b {
    translate: 760px 0;
}

.mess-value {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    width: 72px;
    font-size: 26px;
    -unity-text-align: middle-right;
    color: var(--c-ink);
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.mess-value--bump {
    scale: 1.3 1.3;
}

.predator {
    top: 24px;
    right: 32px;
    align-items: center;
    padding: 14px 18px 12px 18px;
}

.predator-meter {
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    transition-property: scale;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-out-sine;
}

.predator-meter--danger.predator-meter--b {
    scale: 1.1 1.1;
}

.predator-value {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 24px;
    color: var(--c-ink);
    transition-property: color;
    transition-duration: 0.3s;
}

.predator-meter--danger > .predator-value {
    color: var(--c-danger);
}

/* The menu template's container is only a holder; its screen fills the view. */
.menu {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* ---------- Pause and end screens (layout shared with the main menu) ---------- */

.screen-kicker {
    margin-top: 40px;
}

.end-kicker {
    margin-bottom: 18px;
}

.end-screen--lose .end-kicker {
    color: #E58A6F;
}

/* Kris's death HUD (uGUI) shows the mess (as village anger) and the predator: ours stay hidden. */
.mess, .predator {
    display: none;
}

/* Score multiplier (village anger x brood), under Kris's village anger bar */
.mess-mult {
    position: absolute;
    top: 104px;
    left: 50%;
    translate: -50% 0;
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    padding: 4px 10px;
    font-size: 20px;
    -unity-text-align: middle-center;
    color: var(--c-ink);
    background-color: var(--c-gold);
    border-bottom-width: 3px;
    border-color: var(--c-gold-lip);
    border-radius: 14px;
    transition-property: opacity, scale;
    transition-duration: 0.25s, 0.15s;
    transition-timing-function: ease-out-cubic, ease-out-back;
}

.mess-mult--off {
    opacity: 0;
}

.mess-mult--bump {
    scale: 1.3 1.3;
}

/* Cover status under the predator ring: Hidden / Speed boost / Safe */
.cover-status {
    position: absolute;
    top: 190px;
    right: 32px;
    min-width: 140px;
    padding: 8px 16px;
    font-size: 17px;
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-center;
    color: var(--c-cream-hi);
    border-radius: 18px;
    border-bottom-width: 3px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}

.cover-status--off {
    opacity: 0;
    translate: 0 -8px;
}

.cover-status--hidden {
    background-color: rgb(63, 125, 118);
    border-color: rgb(40, 86, 81);
}

.cover-status--boost {
    color: var(--c-ink);
    background-color: var(--c-gold);
    border-color: var(--c-gold-lip);
}

.cover-status--safe {
    background-color: var(--c-green);
    border-color: rgb(80, 99, 56);
}

/* Short messages (a mate joined, butterflies hatched) */
.hud-toast {
    position: absolute;
    bottom: 190px;
    left: 50%;
    translate: -50% 0;
    padding: 10px 22px;
    font-size: 20px;
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--c-ink);
    background-color: rgba(244, 239, 225, 0.94);
    border-bottom-width: 3px;
    border-color: var(--c-cream-lip);
    border-radius: 20px;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

.hud-toast--off {
    opacity: 0;
    translate: -50% 12px;
}

.activity-prompt {
    bottom: 96px;
}
