/* Warm low-poly palette: butterfly cream, deep ink, foliage green, timber brown, pollen gold, sky blue.
   Screens float over the live village; soft petal shapes, nothing harsh. */
:root {
    --c-cream: #F4EFE1;
    --c-cream-hi: #FFFDF7;
    --c-cream-lip: #C9BFA6;
    --c-ink: #27252B;
    --c-green: #728A52;
    --c-earth: #8C694D;
    --c-earth-deep: #5E4430;
    --c-gold: #E9B65D;
    --c-gold-lip: #B88A3C;
    --c-sky: #8DB4C7;
    --c-danger: #C8553D;
    --c-track: #DCD4BF;
    --c-scrim: rgba(39, 37, 43, 0.35);
    --c-scrim-strong: rgba(39, 37, 43, 0.58);

    -unity-font: url("project://database/Assets/UI/Fonts/Inter-Regular.ttf");
    color: var(--c-cream);
    font-size: 24px;
}

/* Without Unity's default theme the document root isn't stretched, so do it here. */
.unity-ui-document__root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

/* ---------- Text ---------- */

.display-title {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 116px;
    margin: 0 0 -18px 0;
    padding: 0;
    color: var(--c-cream);
    text-shadow: 0 5px 0 rgba(39, 37, 43, 0.4);
}

.kicker {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 20px;
    letter-spacing: 7px;
    margin: 0 0 0 4px;
    padding: 0;
    color: var(--c-gold);
    text-shadow: 0 2px 0 rgba(39, 37, 43, 0.45);
}

.lede {
    font-size: 24px;
    margin: 34px 0 0 4px;
    padding: 0;
    color: var(--c-cream);
    text-shadow: 0 2px 0 rgba(39, 37, 43, 0.45);
}

.section-title {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 48px;
    margin: 0 0 24px 0;
    color: var(--c-ink);
}

/* ---------- Petal buttons: three round corners, one small "stem" corner ----------
   Structure: .pbtn-wrap > .pbtn-glow--outer, .pbtn-glow--inner, Button.pbtn.
   The wrapper lifts on hover; USS has no box-shadow, so the glow is two tinted shapes behind the button. */

.pbtn-wrap {
    margin: 11px 0;
    transition-property: translate, opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-cubic;
}

.pbtn-wrap:hover {
    translate: 0 -4px;
}

.pbtn-glow--outer,
.pbtn-glow--inner {
    position: absolute;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-cubic;
}

.pbtn-wrap:hover .pbtn-glow--outer,
.pbtn-wrap:hover .pbtn-glow--inner {
    opacity: 1;
}

.pbtn-glow--outer {
    background-color: rgba(233, 182, 93, 0.2);
}

.pbtn-glow--inner {
    background-color: rgba(233, 182, 93, 0.5);
}

.pbtn {
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-left;
    letter-spacing: 4px;
    margin: 0;
    border-width: 0;
    transform-origin: center bottom;
    transition-property: scale, border-bottom-width, border-color, background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-cubic;
}

.pbtn:active {
    scale: 1.04 0.9;
    transition-duration: 0.08s;
}

.pbtn:focus {
    border-top-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-color: var(--c-cream);
}

/* Primary: pollen gold */
.pbtn--primary {
    width: 384px;
    height: 92px;
    padding: 0 0 0 42px;
    font-size: 32px;
    color: var(--c-ink);
    background-color: var(--c-gold);
    border-bottom-width: 6px;
    border-color: var(--c-gold-lip);
    border-top-left-radius: 46px;
    border-top-right-radius: 46px;
    border-bottom-right-radius: 46px;
    border-bottom-left-radius: 14px;
}

.pbtn--primary:active {
    border-bottom-width: 3px;
}

.pbtn--primary:focus {
    border-color: var(--c-ink);
}

.pbtn-wrap--primary > .pbtn-glow--inner {
    top: -7px;
    right: -7px;
    bottom: -7px;
    left: -7px;
    border-top-left-radius: 53px;
    border-top-right-radius: 53px;
    border-bottom-right-radius: 53px;
    border-bottom-left-radius: 21px;
}

.pbtn-wrap--primary > .pbtn-glow--outer {
    top: -15px;
    right: -15px;
    bottom: -15px;
    left: -15px;
    border-top-left-radius: 61px;
    border-top-right-radius: 61px;
    border-bottom-right-radius: 61px;
    border-bottom-left-radius: 29px;
}

/* Secondary: butterfly cream */
.pbtn--secondary {
    width: 324px;
    height: 70px;
    padding: 0 0 0 34px;
    font-size: 22px;
    color: var(--c-ink);
    background-color: var(--c-cream);
    border-bottom-width: 5px;
    border-color: var(--c-cream-lip);
    border-top-left-radius: 35px;
    border-top-right-radius: 35px;
    border-bottom-right-radius: 35px;
    border-bottom-left-radius: 11px;
}

.pbtn--secondary:active {
    border-bottom-width: 2px;
}

.pbtn--secondary:focus {
    border-color: var(--c-gold);
}

.pbtn-wrap--secondary > .pbtn-glow--inner {
    top: -6px;
    right: -6px;
    bottom: -6px;
    left: -6px;
    border-top-left-radius: 41px;
    border-top-right-radius: 41px;
    border-bottom-right-radius: 41px;
    border-bottom-left-radius: 17px;
}

.pbtn-wrap--secondary > .pbtn-glow--outer {
    top: -13px;
    right: -13px;
    bottom: -13px;
    left: -13px;
    border-top-left-radius: 48px;
    border-top-right-radius: 48px;
    border-bottom-right-radius: 48px;
    border-bottom-left-radius: 24px;
}

/* Ghost: outline only, least prominent; for dark scrims */
.pbtn--ghost {
    width: 264px;
    height: 58px;
    padding: 0 0 0 30px;
    font-size: 18px;
    color: var(--c-cream);
    background-color: rgba(39, 37, 43, 0.3);
    border-width: 2px;
    border-color: rgba(244, 239, 225, 0.75);
    border-top-left-radius: 29px;
    border-top-right-radius: 29px;
    border-bottom-right-radius: 29px;
    border-bottom-left-radius: 9px;
}

.pbtn-wrap:hover > .pbtn--ghost {
    background-color: rgba(39, 37, 43, 0.45);
    border-color: var(--c-gold);
}

.pbtn-wrap--ghost > .pbtn-glow--inner {
    top: -6px;
    right: -6px;
    bottom: -6px;
    left: -6px;
    background-color: rgba(233, 182, 93, 0.32);
    border-top-left-radius: 35px;
    border-top-right-radius: 35px;
    border-bottom-right-radius: 35px;
    border-bottom-left-radius: 15px;
}

/* Compact primary, for buttons inside a card */
.pbtn--compact {
    width: 260px;
    height: 68px;
    padding: 0 0 0 32px;
    font-size: 24px;
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-right-radius: 34px;
    border-bottom-left-radius: 11px;
}

.pbtn-wrap--compact > .pbtn-glow--inner {
    top: -6px;
    right: -6px;
    bottom: -6px;
    left: -6px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 17px;
}

.pbtn-wrap--compact > .pbtn-glow--outer {
    top: -13px;
    right: -13px;
    bottom: -13px;
    left: -13px;
    border-top-left-radius: 47px;
    border-top-right-radius: 47px;
    border-bottom-right-radius: 47px;
    border-bottom-left-radius: 24px;
}

/* ---------- Panels ---------- */

.card {
    align-items: center;
    padding: 44px 56px;
    background-color: var(--c-cream);
    border-bottom-width: 8px;
    border-color: var(--c-cream-lip);
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-right-radius: 36px;
    border-bottom-left-radius: 12px;
}

/* ---------- Screens: fade + gentle zoom in, children slide in one after another ---------- */

.screen {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 1.04 1.04;
    transition-property: opacity, scale;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.screen--scrim {
    background-color: var(--c-scrim);
}

.screen--scrim-strong {
    background-color: var(--c-scrim-strong);
}

/* Title and buttons in the left third, so the village stays the focus. */
.side-screen {
    align-items: flex-start;
    padding-left: 160px;
}

.side-scrim {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.side-column {
    width: 620px;
    align-items: flex-start;
}

.side-buttons {
    align-items: flex-start;
    margin-top: 56px;
}

.screen--open {
    opacity: 1;
    scale: 1 1;
}

.hidden {
    display: none;
}

.reveal {
    opacity: 0;
    translate: 0 32px;
    transition-property: opacity, translate;
    transition-duration: 0.45s, 0.45s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.screen--open .reveal {
    opacity: 1;
    translate: 0 0;
}

.delay-1 { transition-delay: 0.08s, 0.08s; }
.delay-2 { transition-delay: 0.16s, 0.16s; }
.delay-3 { transition-delay: 0.24s, 0.24s; }
.delay-4 { transition-delay: 0.32s, 0.32s; }
.delay-5 { transition-delay: 0.40s, 0.40s; }

/* Ping-pong loops: UIAnim.Loop toggles the --b class every time the transition ends. */

.bob-loop {
    translate: 0 -6px;
    transition-property: translate;
    transition-duration: 1.6s;
    transition-timing-function: ease-in-out-sine;
}

.bob-loop--b {
    translate: 0 6px;
}

/* Full-screen cover for scene changes: starts on, fades out once the scene is up. */
.fade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: var(--c-ink);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-out-cubic;
}

.fade--on {
    opacity: 1;
}

/* ---------- Settings ---------- */

.settings {
    width: 760px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 12px;
    border-radius: 16px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.setting-row:hover {
    background-color: rgba(39, 37, 43, 0.06);
}

.setting-label {
    width: 260px;
    color: var(--c-ink);
}

.setting-value {
    width: 90px;
    -unity-text-align: middle-right;
    color: var(--c-earth);
    -unity-font: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
}

.settings-back {
    margin-top: 28px;
}

/* Slider (no default theme, so every part is styled here) */

.slider {
    flex-grow: 1;
    height: 40px;
    margin: 0 8px;
}

.slider > .unity-base-field__input {
    flex-grow: 1;
}

.slider .unity-base-slider__drag-container {
    flex-grow: 1;
}

.slider .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 10px;
    margin-top: -5px;
    background-color: var(--c-track);
    border-radius: 5px;
}

.slider .unity-base-slider__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    background-color: var(--c-gold);
    border-radius: 5px;
}

.slider .unity-base-slider__dragger-border {
    display: none;
}

.slider .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    width: 28px;
    height: 28px;
    margin-top: -14px;
    background-color: var(--c-cream-hi);
    border-width: 4px;
    border-color: var(--c-gold);
    border-radius: 14px;
    transition-property: scale;
    transition-duration: 0.15s;
}

.slider:hover .unity-base-slider__dragger {
    scale: 1.2 1.2;
}

/* Toggle drawn as a sliding switch */

.switch {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    margin: 0 8px;
}

.switch .unity-toggle__input {
    width: 72px;
    height: 38px;
    padding: 4px;
    background-color: var(--c-track);
    border-radius: 19px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.switch .unity-toggle__checkmark {
    width: 30px;
    height: 30px;
    background-color: var(--c-cream-hi);
    border-radius: 15px;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-cubic;
}

.switch:checked .unity-toggle__input {
    background-color: var(--c-gold);
}

.switch:checked .unity-toggle__checkmark {
    translate: 34px 0;
}
