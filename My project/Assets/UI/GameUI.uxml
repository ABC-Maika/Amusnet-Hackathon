<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:b="ButterflyUI">
    <ui:Template name="Settings" src="Settings.uxml" />
    <ui:Template name="MainMenu" src="MainMenu.uxml" />
    <ui:Style src="Common.uss" />
    <ui:Style src="GameUI.uss" />
    <ui:VisualElement name="root" class="game-root" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud hud--off" picking-mode="Ignore">
            <ui:VisualElement class="mess" picking-mode="Ignore">
                <ui:Label text="MESS" class="hud-caption" />
                <ui:VisualElement class="mess-track" picking-mode="Ignore">
                    <ui:VisualElement name="messFill" class="mess-fill" picking-mode="Ignore">
                        <ui:VisualElement class="mess-shine" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="messValue" text="0%" class="mess-value" />
            </ui:VisualElement>
            <ui:VisualElement name="predator" class="predator" picking-mode="Ignore">
                <b:RadialMeter name="predatorMeter" class="predator-meter" picking-mode="Ignore"
                    track-color="#1C1736E6" low-color="#A78BFA" high-color="#FF5468">
                    <ui:Label name="predatorValue" text="0%" class="predator-value" />
                </b:RadialMeter>
                <ui:Label text="PREDATOR" class="hud-caption" />
            </ui:VisualElement>
            <ui:Label text="Esc to pause" class="hud-hint" />
        </ui:VisualElement>

        <ui:Instance template="MainMenu" name="menu" class="menu" picking-mode="Ignore" />

        <ui:VisualElement name="pauseScreen" class="screen screen--scrim hidden">
            <ui:VisualElement class="card">
                <ui:Label text="Paused" class="section-title reveal" />
                <ui:VisualElement class="reveal delay-1">
                    <ui:Button name="resumeButton" text="Resume" class="btn btn--primary" />
                </ui:VisualElement>
                <ui:VisualElement class="reveal delay-2">
                    <ui:Button name="pauseSettingsButton" text="Settings" class="btn" />
                </ui:VisualElement>
                <ui:VisualElement class="reveal delay-3">
                    <ui:Button name="pauseMenuButton" text="Main Menu" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settingsScreen" class="screen screen--scrim hidden">
            <ui:Instance template="Settings" />
        </ui:VisualElement>

        <ui:VisualElement name="winScreen" class="screen screen--scrim end-screen end-screen--win hidden">
            <ui:Label text="Victory" class="end-kicker reveal" />
            <ui:Label text="The village is empty" class="title end-title" />
            <ui:Label text="Nature takes back what was hers." class="subtitle reveal delay-2" />
            <ui:VisualElement class="end-buttons">
                <ui:VisualElement class="reveal delay-3">
                    <ui:Button name="winRestartButton" text="Play Again" class="btn btn--primary" />
                </ui:VisualElement>
                <ui:VisualElement class="reveal delay-4">
                    <ui:Button name="winMenuButton" text="Main Menu" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loseScreen" class="screen screen--scrim end-screen end-screen--lose hidden">
            <ui:Label text="Game Over" class="end-kicker reveal" />
            <ui:Label text="Caught!" class="title end-title" />
            <ui:Label text="The rebellion will remember your flight." class="subtitle reveal delay-2" />
            <ui:VisualElement class="end-buttons">
                <ui:VisualElement class="reveal delay-3">
                    <ui:Button name="loseRestartButton" text="Try Again" class="btn btn--primary" />
                </ui:VisualElement>
                <ui:VisualElement class="reveal delay-4">
                    <ui:Button name="loseMenuButton" text="Main Menu" class="btn" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade fade--on" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
