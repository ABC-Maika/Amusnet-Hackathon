<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:b="ButterflyUI">
    <ui:Template name="Settings" src="Settings.uxml" />
    <ui:Template name="MainMenu" src="MainMenu.uxml" />
    <ui:Style src="Common.uss" />
    <ui:Style src="GameUI.uss" />
    <ui:VisualElement name="root" class="game-root" picking-mode="Ignore">
        <ui:VisualElement name="hud" class="hud hud--off" picking-mode="Ignore">
            <ui:VisualElement class="hud-card mess" picking-mode="Ignore">
                <ui:Label text="MESS" class="hud-caption" />
                <ui:VisualElement class="mess-track" picking-mode="Ignore">
                    <ui:VisualElement name="messFill" class="mess-fill" picking-mode="Ignore">
                        <ui:VisualElement class="mess-shine" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="messValue" text="0%" class="mess-value" />
                <ui:Label name="messMultiplier" text="×1" class="mess-mult mess-mult--off" />
            </ui:VisualElement>
            <ui:VisualElement name="predator" class="hud-card predator" picking-mode="Ignore">
                <b:RadialMeter name="predatorMeter" class="predator-meter" picking-mode="Ignore"
                    track-color="#DCD4BF" low-color="#728A52" high-color="#C8553D" thickness="9">
                    <ui:Label name="predatorValue" text="0%" class="predator-value" />
                </b:RadialMeter>
                <ui:Label text="PREDATOR" class="hud-caption" />
            </ui:VisualElement>
            <ui:Label name="coverStatus" text="" class="cover-status cover-status--off" />
            <ui:Label name="toast" text="" class="hud-toast hud-toast--off" />
            <ui:Label text="Esc to pause" class="hud-hint" />
        </ui:VisualElement>

        <ui:Instance template="MainMenu" name="menu" class="menu" picking-mode="Ignore" />

        <ui:VisualElement name="pauseScreen" class="screen screen--scrim side-screen hidden">
            <b:MenuScrim class="side-scrim" picking-mode="Ignore" />
            <ui:VisualElement class="side-column" picking-mode="Ignore">
                <ui:Label text="Paused" class="display-title reveal" />
                <ui:Label text="ESC TO RESUME" class="kicker screen-kicker reveal delay-1" />
                <ui:VisualElement class="side-buttons" picking-mode="Ignore">
                    <ui:VisualElement class="reveal delay-2" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--primary">
                            <ui:VisualElement class="pbtn-glow--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="resumeButton" text="RESUME" class="pbtn pbtn--primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="reveal delay-3" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--secondary">
                            <ui:VisualElement class="pbtn-glow--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="pauseSettingsButton" text="SETTINGS" class="pbtn pbtn--secondary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="reveal delay-4" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--ghost">
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="pauseMenuButton" text="MAIN MENU" class="pbtn pbtn--ghost" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settingsScreen" class="screen screen--scrim-strong hidden">
            <ui:Instance template="Settings" />
        </ui:VisualElement>

        <ui:VisualElement name="winScreen" class="screen screen--scrim side-screen end-screen end-screen--win hidden">
            <b:MenuScrim class="side-scrim" picking-mode="Ignore" />
            <ui:VisualElement class="side-column" picking-mode="Ignore">
                <ui:Label text="VICTORY" class="kicker end-kicker reveal" />
                <ui:Label text="The village" class="display-title reveal delay-1" />
                <ui:Label text="is empty" class="display-title reveal delay-1" />
                <ui:Label text="Nature takes back what was hers." class="lede reveal delay-2" />
                <ui:VisualElement class="side-buttons" picking-mode="Ignore">
                    <ui:VisualElement class="reveal delay-3" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--primary">
                            <ui:VisualElement class="pbtn-glow--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="winRestartButton" text="PLAY AGAIN" class="pbtn pbtn--primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="reveal delay-4" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--secondary">
                            <ui:VisualElement class="pbtn-glow--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="winMenuButton" text="MAIN MENU" class="pbtn pbtn--secondary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="loseScreen" class="screen screen--scrim side-screen end-screen end-screen--lose hidden">
            <b:MenuScrim class="side-scrim" picking-mode="Ignore" />
            <ui:VisualElement class="side-column" picking-mode="Ignore">
                <ui:Label text="GAME OVER" class="kicker end-kicker reveal" />
                <ui:Label text="Caught!" class="display-title reveal delay-1" />
                <ui:Label text="The rebellion will remember your flight." class="lede reveal delay-2" />
                <ui:VisualElement class="side-buttons" picking-mode="Ignore">
                    <ui:VisualElement class="reveal delay-3" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--primary">
                            <ui:VisualElement class="pbtn-glow--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="loseRestartButton" text="TRY AGAIN" class="pbtn pbtn--primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="reveal delay-4" picking-mode="Ignore">
                        <ui:VisualElement class="pbtn-wrap pbtn-wrap--secondary">
                            <ui:VisualElement class="pbtn-glow--outer" picking-mode="Ignore" />
                            <ui:VisualElement class="pbtn-glow--inner" picking-mode="Ignore" />
                            <ui:Button name="loseMenuButton" text="MAIN MENU" class="pbtn pbtn--secondary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="fade" class="fade fade--on" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
