{
  "enabledMcpjsonServers": [
    "hacky"
  ],
  "permissions": {
    "allow": [
      "mcp__hacky"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y hacky-mcp-server@0.1.2 touch",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
